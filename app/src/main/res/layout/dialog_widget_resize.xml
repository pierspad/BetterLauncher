<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/TextSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:accessibilityHeading="true"
        android:text="@string/widget_resize" />

    <LinearLayout
        android:id="@+id/widgetResizeControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widgetResizeApply"
        style="@style/DialogPrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@android:string/ok" />

    <TextView
        android:id="@+id/widgetResizeFill"
        style="@style/DialogSecondaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_fill_height"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widgetResizeCancel"
        style="@style/DialogSecondaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel" />
</LinearLayout>
