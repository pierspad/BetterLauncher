<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_dialog_surface"
    android:clipToOutline="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/TextSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:accessibilityHeading="true"
        android:text="@string/widget_choose" />

    <TextView
        android:id="@+id/widgetSpace"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="?attr/primaryColorTrans80"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/widgetSearch"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_settings_search"
        android:backgroundTint="@null"
        android:drawablePadding="12dp"
        android:hint="@string/widget_search"
        android:imeOptions="actionDone"
        android:inputType="text|textNoSuggestions"
        android:minHeight="52dp"
        android:padding="14dp"
        android:singleLine="true"
        app:drawableStartCompat="@drawable/ic_sc_search" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widgetList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null" />

        <TextView
            android:id="@+id/widgetEmpty"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/widget_search_empty" />
    </FrameLayout>

    <TextView
        android:id="@+id/widgetCancel"
        style="@style/DialogSecondaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel" />
</LinearLayout>
