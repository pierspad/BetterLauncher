<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog_surface"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="10dp">

    <TextView
        style="@style/TextSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:shadowRadius="0"
        android:text="@string/choose_icon" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/iconSearch"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_settings_search"
        android:backgroundTint="@null"
        android:drawablePadding="10dp"
        android:hint="@string/shortcut_picker_search"
        android:imeOptions="actionDone"
        android:inputType="text|textNoSuggestions"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        app:drawableStartCompat="@drawable/ic_sc_search" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/iconCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rounded_settings_search"
        android:popupBackground="@drawable/rounded_dialog_surface"
        android:minHeight="48dp"
        android:spinnerMode="dropdown" />

    <!-- Start with room for four rows and let the grid shrink when space is limited. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_weight="1"
        tools:ignore="InefficientWeight">

        <GridView
            android:id="@+id/iconGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="66dp"
            android:horizontalSpacing="4dp"
            android:numColumns="auto_fit"
            android:stretchMode="columnWidth"
            android:verticalSpacing="4dp" />

        <TextView
            android:id="@+id/iconEmpty"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/shortcut_picker_empty"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/iconPickerClose"
        style="@style/DialogSecondaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/close" />
</LinearLayout>
