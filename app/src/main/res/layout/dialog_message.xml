<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog_surface" android:clipToOutline="true"
    android:orientation="vertical" android:paddingHorizontal="24dp"
    android:paddingTop="26dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/dialogTitle" style="@style/TextSectionTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityHeading="true" android:layout_marginBottom="14dp" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView android:id="@+id/dialogMessage" style="@style/TextSmall"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp" android:textColor="?attr/primaryColorTrans80" />
    </ScrollView>
    <TextView android:id="@+id/dialogPositiveButton" style="@style/DialogPrimaryAction"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="22dp" />
    <TextView android:id="@+id/dialogNegativeButton" style="@style/DialogSecondaryAction"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:visibility="gone" />
</LinearLayout>
